#!/usr/bin/env bash
set -euo pipefail

PODMAN_BIN="${PODMAN_BIN:-podman}"
IMAGE="${GODOT_CONTAINER_IMAGE:-openebfd-godot:4.7}"
GODOT_VERSION="${GODOT_VERSION:-4.7}"
GODOT_RELEASE="${GODOT_RELEASE:-stable}"
PROJECT_DIR="${GODOT_PROJECT_DIR:-$(pwd)}"
CONTAINERFILE="${GODOT_CONTAINERFILE:-${PROJECT_DIR}/Containerfile}"
WEB_EXPORT_PATH="${GODOT_WEB_EXPORT_PATH:-exports/web/index.html}"
# The relay is the one godot-* target that needs to actually be reached from
# outside the container: every other command here is one-shot (a converter,
# a test run, an export) and never needs a published port. Without -p, a
# process inside the container listening on this port is unreachable from
# the host -- verified directly (started the relay through the plain `godot`
# passthrough with no publish, confirmed relay_main.gd's own startup log
# line printed, then a host-side TCP connect attempt to the same port was
# refused) rather than assumed.
RELAY_PORT="${GODOT_RELAY_PORT:-8910}"
# Container-side backstop deadline for one-shot commands (check, lint, godot
# passthrough, exports, converters run through `godot`). `podman run
# --timeout` makes the container kill itself from the inside, which is what
# actually bounds its lifetime: an external `timeout` (as tools/run_godot_tests.sh
# wraps each suite in) only kills the local `podman run` client -- conmon and
# the container keep running regardless, indefinitely, competing for the
# /workspace mount with every later suite. Not applied to `relay` (a
# long-running server by design), `shell` (interactive), or `watch-export`
# (continuous) -- a deadline would just kill those mid-session.
TIMEOUT_SECONDS="${GODOT_CONTAINER_TIMEOUT_SECONDS:-300}"


usage() {
	cat <<'USAGE'
Usage: ./tools/godot-container <command> [args]

Commands:
  build          Build the Podman image with Godot and Web templates.
  version        Print Godot version from the container.
  check          Import/validate the mounted project in headless mode.
  lint           Run the pinned gdtoolkit linter over project GDScript.
  export-web     Export the Web preset to exports/web/index.html.
  watch-export   Re-export Web when project files change.
  shell          Open a shell inside the mounted project container.
  godot [args]   Run arbitrary Godot arguments in the container.
  relay [args]   Run the relay server, with its port published to the host.
                 [args] are passed through to relay_main.gd after --port, so
                 e.g. --max-connections 256 works. See GODOT_RELAY_PORT.
  image          Print the resolved image tag (GODOT_CONTAINER_IMAGE).

Environment:
  GODOT_CONTAINER_IMAGE   Image tag. Default: openebfd-godot:4.7
  GODOT_VERSION           Godot version to build. Default: 4.7
  GODOT_RELEASE           Godot release channel. Default: stable
  GODOT_PROJECT_DIR       Host project directory. Default: current directory
  GODOT_WEB_EXPORT_PATH   Export path. Default: exports/web/index.html
  GODOT_RELAY_PORT        Relay port, both inside the container and
                           published to the host. Default: 8910
  GODOT_CONTAINER_TIMEOUT_SECONDS
                           Container-side deadline (seconds) for one-shot
                           commands (check, lint, godot, exports/converters).
                           Not applied to relay, shell, or watch-export.
                           Default: 300
USAGE
}


tty_flags() {
	if [[ -t 0 && -t 1 ]]; then
		printf '%s\n' "-it"
	fi
}


podman_base_args() {
	# $1, if non-empty, is a container-side --timeout deadline in seconds.
	# Callers that must not have one (relay, shell, watch-export) pass "".
	local deadline="${1:-}"
	local tty_flag
	tty_flag="$(tty_flags)"

	if [[ -n "${tty_flag}" ]]; then
		printf '%s\n' "${tty_flag}"
	fi

	printf '%s\n' \
		--rm \
		--userns=keep-id \
		--volume "${PROJECT_DIR}:/workspace:Z" \
		--workdir /workspace

	if [[ -n "${deadline}" ]]; then
		printf '%s\n' --timeout "${deadline}"
	fi
}


run_godot() {
	mapfile -t base_args < <(podman_base_args "${TIMEOUT_SECONDS}")
	"${PODMAN_BIN}" run "${base_args[@]}" "${IMAGE}" "$@"
}


run_shell() {
	# $1 is a container-side --timeout deadline in seconds, or "" for none
	# (see podman_base_args). Callers pick per the same split as run_godot.
	local deadline="$1"
	shift
	mapfile -t base_args < <(podman_base_args "${deadline}")
	"${PODMAN_BIN}" run "${base_args[@]}" --entrypoint bash "${IMAGE}" "$@"
}


build_image() {
	"${PODMAN_BIN}" build \
		--build-arg "GODOT_VERSION=${GODOT_VERSION}" \
		--build-arg "GODOT_RELEASE=${GODOT_RELEASE}" \
		--tag "${IMAGE}" \
		--file "${CONTAINERFILE}" \
		"${PROJECT_DIR}"
}


check_project() {
	run_godot --headless --path /workspace --quit
}


export_web() {
	mkdir -p "${PROJECT_DIR}/$(dirname "${WEB_EXPORT_PATH}")"
	run_godot --headless --path /workspace --export-release Web "/workspace/${WEB_EXPORT_PATH}"
}


watch_export() {
	mkdir -p "${PROJECT_DIR}/$(dirname "${WEB_EXPORT_PATH}")"
	run_shell "" -lc "set -e; while true; do godot --headless --path /workspace --export-release Web '/workspace/${WEB_EXPORT_PATH}' || true; inotifywait -r -e close_write,create,delete,move --exclude '(^|/)(\\.git|\\.godot|exports)(/|$)' /workspace; done"
}


run_relay() {
	mapfile -t base_args < <(podman_base_args)
	"${PODMAN_BIN}" run "${base_args[@]}" -p "${RELAY_PORT}:${RELAY_PORT}" "${IMAGE}" \
		godot --headless --path /workspace --script res://scripts/net/relay/relay_main.gd \
		-- --port "${RELAY_PORT}" "$@"
}


command="${1:-}"
if [[ -n "${command}" ]]; then
	shift
fi

case "${command}" in
	build)
		build_image
		;;
	version)
		run_godot --version
		;;
	check)
		check_project
		;;
	lint)
		run_shell "${TIMEOUT_SECONDS}" -lc "/opt/gdtoolkit/bin/gdlint scripts tests converters"
		;;
	export-web)
		export_web
		;;
	watch-export)
		watch_export
		;;
	shell)
		run_shell "" "$@"
		;;
	godot)
		run_godot "$@"
		;;
	relay)
		run_relay "$@"
		;;
	image)
		printf '%s\n' "${IMAGE}"
		;;
	""|help|--help|-h)
		usage
		;;
	*)
		printf 'Unknown command: %s\n\n' "${command}" >&2
		usage >&2
		exit 2
		;;
esac
