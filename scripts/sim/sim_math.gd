static func bearing_units(x: float, z: float) -> int:
	if x == 0.0:
		if z > 0.0:
			return QUARTER
		if z < 0.0:
			return -QUARTER
		return 0
	if z == 0.0:
		return HALF if x < 0.0 else 0
	var ax := absf(x)
	var az := absf(z)
	var scaled := int(minf(ax, az) / maxf(ax, az) * 256.0 * RATIO_SCALE)
	var index := mini(256, scaled / RATIO_SCALE)
	var octant := _atan_units_table[index]
	if index < 256:
		var fraction := scaled - index * RATIO_SCALE
		octant += ((_atan_units_table[index + 1] - octant) * fraction + RATIO_SCALE / 2) / RATIO_SCALE
	var angle := octant if ax >= az else QUARTER - octant
	if x < 0.0:
		angle = HALF - angle
	return -angle if z < 0.0 else angle


static func signed_delta_units(a: int, b: int) -> int:
	var raw := b - a
	if raw == HALF:
		return -HALF
	if raw == -HALF:
		return HALF
	return posmod(raw + HALF, TURN) - HALF


static func _sine_q30(angle: int) -> int:
	var wrapped := posmod(angle, TURN)
	var quadrant := wrapped / QUARTER
	var within := wrapped % QUARTER
	if quadrant == 1 or quadrant == 3:
		within = QUARTER - within
	var index := within / KNOT_WIDTH
	var value := _sine_q30_table[index]
	if index < 256:
		var fraction := within % KNOT_WIDTH
		value += ((_sine_q30_table[index + 1] - value) * fraction + KNOT_WIDTH / 2) / KNOT_WIDTH
	return -value if quadrant >= 2 else value


static func sin_cos_units(angle: int) -> Vector2:
	var wrapped := posmod(angle, TURN)
	var quadrant := wrapped / QUARTER
	var within := wrapped % QUARTER
	var first := within if quadrant == 0 or quadrant == 2 else QUARTER - within
	var second := QUARTER - first
	var first_index := first / KNOT_WIDTH
	var first_value := _sine_q30_table[first_index]
	if first_index < 256:
		var fraction := first % KNOT_WIDTH
		first_value += ((_sine_q30_table[first_index + 1] - first_value) * fraction + KNOT_WIDTH / 2) / KNOT_WIDTH
	var second_index := second / KNOT_WIDTH
	var second_value := _sine_q30_table[second_index]
	if second_index < 256:
		var fraction := second % KNOT_WIDTH
		second_value += ((_sine_q30_table[second_index + 1] - second_value) * fraction + KNOT_WIDTH / 2) / KNOT_WIDTH
	var sine := -first_value if quadrant >= 2 else first_value
	var cosine := -second_value if quadrant == 1 or quadrant == 2 else second_value
	return Vector2(float(cosine) / 1073741824.0, float(sine) / 1073741824.0)


static func damped_horizontal(previous_unit: Vector3, target_unit: Vector3) -> Vector3:
	var cross := previous_unit.x * target_unit.z - previous_unit.z * target_unit.x
	var dot := previous_unit.x * target_unit.x + previous_unit.z * target_unit.z
	if dot > 0.0 and cross * cross <= 0.0045 * 0.0045 * dot * dot:
		return previous_unit
	var gap := -HALF if cross == 0.0 and dot < 0.0 else bearing_units(dot, cross)
	if absi(gap) <= DAMPING_GATE_UNITS:
		return previous_unit
	var magnitude := (absi(gap) * 7 + 10) / 20
	var turn := -magnitude if gap < 0 else magnitude
	var pair := sin_cos_units(turn)
	return Vector3(previous_unit.x * pair.x - previous_unit.z * pair.y, 0.0,
		previous_unit.z * pair.x + previous_unit.x * pair.y)
